    { "atMs": 2000, "kind": "receive", "type": "CreditUpdate", "payload": { "life": 1, "delta": -1, "reason": "CustomerLeft" } },
    { "atMs": 3000, "kind": "receive", "type": "CreditUpdate", "payload": { "life": 0, "delta": -1, "reason": "CustomerLeft" } }
