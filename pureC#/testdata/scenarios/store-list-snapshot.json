{
  "name": "store-list-snapshot",
  "description": "StoreListUpdateのフルスナップで全店が置換され、自店のStoreStateが巻き戻らないか",
  "steps": [
    { "atMs": 0, "kind": "connection", "state": "Connected" },
    {
      "atMs": 0,
      "kind": "receive",
      "type": "MatchStart",
      "payload": {
        "matchId": "m-01",
        "selfStoreId": "s-self",
        "params": { "matchTimeLimitMs": 300000, "initialLife": 3, "maxStores": 99 },
        "phase": "Early",
        "stores": [
          { "storeId": "s-self", "displayName": "自店", "evalNormalized": 0.5, "rank": 50, "creditLife": 3, "alive": true }
        ]
      }
    },
    {
      "atMs": 1000,
      "kind": "receive",
      "type": "StoreListUpdate",
      "payload": {
        "aliveCount": 99,
        "stores": [
          { "storeId": "s-self", "displayName": "自店", "evalNormalized": 0.6, "rank": 40, "creditLife": 3, "alive": true },
          { "storeId": "s-002", "displayName": "2号店", "evalNormalized": 0.4, "rank": 60, "creditLife": 2, "alive": true }
        ]
      }
    },
    {
      "atMs": 2000,
      "kind": "receive",
      "type": "StoreListUpdate",
      "payload": {
        "aliveCount": 98,
        "stores": [
          { "storeId": "s-self", "displayName": "自店", "evalNormalized": 0.65, "rank": 38, "creditLife": 3, "alive": true }
        ]
      }
    }
  ]
}
