{
  "name": "few-players-match",
  "description": "maxStoresに満たない人数（例3店）で開始。ランキング表が破綻しないか",
  "steps": [
    { "atMs": 0, "kind": "connection", "state": "Connected" },
    {
      "atMs": 0,
      "kind": "receive",
      "type": "MatchStart",
      "payload": {
        "matchId": "m-02",
        "selfStoreId": "s-self",
        "params": { "maxStores": 99, "scoreWeightTakoyaki": 100, "scoreWeightMiss": 20 },
        "phase": "Early",
        "startsAtServerMs": 1700000000000,
        "stores": [
          { "storeId": "s-self", "displayName": "自店", "rank": 1, "score": 0, "alive": true },
          { "storeId": "s-002", "displayName": "2号店", "rank": 2, "score": 0, "alive": true },
          { "storeId": "s-003", "displayName": "3号店", "rank": 3, "score": 0, "alive": true }
        ]
      }
    },
    {
      "atMs": 1000,
      "kind": "receive",
      "type": "RankingSnapshot",
      "payload": {
        "entries": [
          { "storeId": "s-self", "rank": 1, "score": 300, "alive": true },
          { "storeId": "s-002", "rank": 2, "score": 200, "alive": true },
          { "storeId": "s-003", "rank": 3, "score": 100, "alive": true }
        ]
      }
    },
    { "atMs": 2000, "kind": "receive", "type": "EvaluationUpdate", "payload": { "score": 300, "rank": 1, "aliveCount": 3 } }
  ]
}
